# --- Core -------------------------------------------------------------
PORT=4000
DATABASE_URL="file:./data/streamrd.db"
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Networking ---------------------------------------------------------
# Base URL the API is reachable at from clients.
API_BASE_URL=http://localhost:4000
# Optional LAN address (e.g. http://192.168.1.50:4000)
LAN_URL=
# Optional public address behind a reverse proxy (e.g. https://media.example.com)
PUBLIC_URL=
# Comma-separated allowed web origins, or * for any.
CORS_ORIGINS=*

# --- Bootstrap ----------------------------------------------------------
# This email is promoted to admin on signup/startup. The very first account
# to sign up is always made admin regardless.
ADMIN_EMAIL=
