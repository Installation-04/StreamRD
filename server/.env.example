# --- Core -------------------------------------------------------------
PORT=47821
DATABASE_URL="file:./data/streamrd.db"
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Networking ---------------------------------------------------------
# Base URL the API is reachable at from clients.
API_BASE_URL=http://localhost:47821
# Optional LAN address (e.g. http://192.168.1.50:47821)
LAN_URL=
# Optional public address behind a reverse proxy (e.g. https://media.example.com)
PUBLIC_URL=
# Comma-separated allowed web origins, or * for any.
CORS_ORIGINS=*

# --- Bootstrap ----------------------------------------------------------
# This email is promoted to admin on signup/startup. The very first account
# signup is admin only when this setting is empty.
ADMIN_EMAIL=

# Optional Plex/Jellyfin symlink export; both must be absolute local paths.
# Leave empty for normal URL-only operation. See docs/plex-jellyfin.md.
MEDIA_SOURCE_ROOT=
MEDIA_LIBRARY_ROOT=
