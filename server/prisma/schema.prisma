// StreamRD data model.
// SQLite is the supported database for this self-hosted application.
// PostgreSQL requires dedicated migrations and adaptations to SQLite-specific queries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  mediaRequests MediaRequest[]
  requestFollows RequestFollower[]
  sharedLibraries SharedLibrary[]
  libraryGrants SharedLibraryGrant[]
  sharedProgress SharedLibraryProgress[]
  id             String         @id @default(cuid())
  sessionVersion Int @default(0)
  revokedSessions RevokedSession[]
  accountMedia AccountMedia[]
  accountScans AccountScan[]
  metadataRecords MetadataRecord[]
  email          String         @unique
  hashedPassword String
  displayName    String
  avatarUrl      String?
  role           String         @default("user") // "user" | "admin"
  maxAge         Int? // viewing limit: the highest minimum age this user may see; null = no limit
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  debridConfig   DebridConfig?
  profiles       Profile[]
  playbackLogs   PlaybackLog[]
  favorites      Favorite[]
  sourceJobs     PlaybackSourceJob[]
  playbackSessions PlaybackSession[]
  playbackProgress PlaybackProgress[]
}

model DebridConfig {
  autoImportLibrary Boolean @default(true)
  userId           String  @id
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryProvider  String  @default("realdebrid") // "realdebrid" | "alldebrid" | "premiumize"
  fallbackOrder    String  @default("[]") // JSON array of provider ids; empty = use global order
  realDebridToken  String?
  allDebridApiKey  String?
  premiumizeApiKey String?
  updatedAt        DateTime @updatedAt
}

model Profile {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  avatarUrl   String?
  playbackSessions PlaybackSession[]
  playbackProgress PlaybackProgress[]
  preferences String   @default("{}") // JSON blob (subtitle language, maturity, ...)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Title {
  id          String        @id @default(cuid())
  name        String
  description String        @default("")
  type        String        @default("movie") // "movie" | "series"
  genres      String        @default("[]") // JSON array of strings
  year        Int?
  posterUrl   String?
  backdropUrl String?
  // JSON array of debrid sources:
  // [{ "kind": "link" | "magnet", "url": "...", "quality": "1080p", "label": "..." }]
  sources     String        @default("[]")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  playbackLogs PlaybackLog[]
  favoritedBy  Favorite[]
  playbackSessions PlaybackSession[]
  playbackProgress PlaybackProgress[]

  @@index([createdAt, id])
  @@index([type, createdAt, id])
}

// "My List" — a user's saved titles, Netflix-style.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, titleId])
  @@index([userId])
  @@index([userId, createdAt, id])
}

model PlaybackLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId      String
  title        Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  providerUsed String
  success      Boolean
  durationMs   Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([userId, success, titleId, createdAt])
  @@index([titleId])
  @@index([createdAt])
}

model LogEvent {
  id        String   @id @default(cuid())
  level     String   @default("info") // "info" | "warn" | "error"
  type      String // "signup" | "login" | "playback" | "provider_error" | ...
  message   String
  userId    String?
  provider  String?
  meta      String? // JSON blob
  createdAt DateTime @default(now())

  @@index([type])
  @@index([level])
  @@index([createdAt])
}

// Key/value store for mutable server + provider settings managed via the admin API.
model Setting {
  key   String @id
  value String // JSON-encoded
}

// Provider references survive retries/restarts; signed stream URLs are never stored.
model PlaybackSourceJob {
  key         String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String?
  expiresAt   DateTime
  leaseUntil  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PlaybackSession {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String?
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  scope String @default("")
  titleId String
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
  mediaKey String
  lastSequence Int @default(-1)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}

model PlaybackProgress {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String?
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  scope String @default("")
  titleId String
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
  mediaKey String
  positionSeconds Float @default(0)
  durationSeconds Float @default(0)
  completed Boolean @default(false)
  activeSessionId String
  updatedAt DateTime @default(now())
  @@unique([userId, scope, titleId, mediaKey])
  @@index([userId, scope, completed, updatedAt, id])
}

model RevokedSession {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

// Durable metadata matching and refresh work for catalog or mounted-library targets.
// Library targets live outside SQLite; no foreign key can represent both kinds.
model MetadataRecord {
  ownerId       String?
  owner         User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  id            String   @id @default(cuid())
  targetType    String
  targetId      String
  name          String
  mediaType     String
  year          Int?
  status        String   @default("queued")
  requestedBy   String   @default("automatic")
  data          String   @default("{}")
  lockedFields  String   @default("[]")
  revision      Int      @default(0)
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil    DateTime?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([targetType, targetId])
  @@index([status, nextAttemptAt])
  @@index([ownerId])
}

// Private imports never persist signed media URLs or appear in the shared catalog.
model AccountMedia {
  id                    String @id @default(cuid())
  userId                String
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String
  providerRef           String
  credentialFingerprint String
  name                  String
  type                  String @default("movie")
  ratingOverride        String? // set by an administrator; wins over the metadata rating
  ratingLabel           String? // the rating in effect, as shown (for example PG-13)
  minAge                Int? // that rating as a minimum age; null = unrated
  year                  Int?
  phase                 String
  progress              Int @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  sharedProgress        SharedLibraryProgress[]
  @@unique([userId, provider, providerRef])
  @@index([userId, createdAt, id])
}

// One recoverable read-only scan per account/provider. Cursor and identity are private.
model AccountScan {
  id                    String @id @default(cuid())
  userId                String
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String
  status                String @default("queued")
  cursor                String?
  credentialFingerprint String
  automatic             Boolean @default(true)
  revision              Int @default(0)
  leaseUntil            DateTime?
  nextAttemptAt         DateTime @default(now())
  failures              Int @default(0)
  pages                 Int @default(0)
  scanned               Int @default(0)
  imported              Int @default(0)
  skipped               Int @default(0)
  error                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@unique([userId, provider])
  @@index([status, nextAttemptAt])
}

// One-use invitation secrets are hashed; only the creation response contains the link token.
model Invitation {
  id String @id @default(cuid())
  tokenHash String @unique
  email String
  createdById String
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  @@index([email, createdAt])
  @@index([expiresAt])
}

// An administrator deliberately publishes their imported account library to selected users.
model SharedLibrary {
  mediaRequests MediaRequest[]
  id String @id @default(cuid())
  name String
  sourceUserId String
  sourceUser User @relation(fields: [sourceUserId], references: [id], onDelete: Cascade)
  mediaType String @default("all")
  enabled Boolean @default(true)
  everyone Boolean @default(false)
  grants SharedLibraryGrant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sourceUserId, createdAt])
}

model SharedLibraryGrant {
  libraryId String
  library SharedLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([libraryId, userId])
  @@index([userId])
}

// A viewer's resume position for a shared import. Contains no provider links or credentials.
model SharedLibraryProgress {
  id              String @id @default(cuid())
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String
  item            AccountMedia @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mediaKey        String
  positionSeconds Float @default(0)
  durationSeconds Float @default(0)
  completed       Boolean @default(false)
  activeSessionId String
  lastSequence    Int @default(-1)
  updatedAt       DateTime @default(now())
  @@unique([userId, itemId, mediaKey])
  @@index([userId, completed, updatedAt, id])
  @@index([itemId])
}

// A canonical title request is shared; followers remain private to their accounts.
model MediaRequest {
 id String @id @default(cuid())
 canonicalKey String @unique
 provider String
 externalId String
 mediaType String
 name String
 year Int?
 metadata String
 status String @default("requested")
 destination String?
 sourceUserId String?
 sourceUser User? @relation(fields: [sourceUserId], references: [id], onDelete: SetNull)
 sharedLibraryId String?
 sharedLibrary SharedLibrary? @relation(fields: [sharedLibraryId], references: [id], onDelete: SetNull)
 sourceUrl String?
 providerId String?
 providerRef String?
 sourceFingerprint String?
 progress Int?
 downloadState String?
 error String?
 revision Int @default(0)
 attempts Int @default(0)
 leaseUntil DateTime?
 nextPollAt DateTime @default(now())
 startedAt DateTime?
 downloadedAt DateTime?
 availableAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 followers RequestFollower[]
 events RequestEvent[]
 @@index([status, nextPollAt])
 @@index([sourceUserId])
 @@index([sharedLibraryId])
}
model RequestFollower {
 requestId String
 request MediaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 @@id([requestId, userId])
 @@index([userId, createdAt])
}
model RequestEvent {
 id String @id @default(cuid())
 requestId String
 request MediaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
 status String
 message String
 progress Int?
 createdAt DateTime @default(now())
 @@index([requestId, createdAt])
}
