# Caddy reverse proxy for Phosphor.
# Set DOMAIN=phosphor.example.com for automatic HTTPS via Let's Encrypt;
# DOMAIN=localhost serves a self-signed cert for local testing.

{$DOMAIN:localhost} {
	handle /api/* {
		reverse_proxy backend:61337
	}
	handle {
		reverse_proxy web:3100
	}

	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}
