# --- Core -------------------------------------------------------------
PORT=61337
DATABASE_URL="file:./data/phosphor.db"
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Networking ---------------------------------------------------------
API_BASE_URL=http://localhost:61337
LAN_URL=
PUBLIC_URL=
CORS_ORIGINS=*

# --- Bootstrap ----------------------------------------------------------
# This email is promoted to admin on signup/startup. The very first account
# signup is admin only when this setting is empty.
ADMIN_EMAIL=

# Optional Plex/Jellyfin symlink export; both must be absolute local paths.
# Leave empty for normal URL-only operation. See docs/plex-jellyfin.md.
MEDIA_SOURCE_ROOT=
MEDIA_LIBRARY_ROOT=
