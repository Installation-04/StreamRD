// Phosphor data model.
// SQLite is the supported database for this self-hosted application.
// PostgreSQL requires dedicated migrations and adaptations to SQLite-specific queries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  mediaRequests MediaRequest[]
  requestFollows RequestFollower[]
  sharedLibraries SharedLibrary[]
  libraryGrants SharedLibraryGrant[]
  id             String         @id @default(cuid())
  sessionVersion Int @default(0)
  revokedSessions RevokedSession[]
  accountMedia AccountMedia[]
  accountScans AccountScan[]
  metadataRecords MetadataRecord[]
  email          String         @unique
  hashedPassword String
  displayName    String
  role           String         @default("user") // "user" | "admin"
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  debridConfig   DebridConfig?
  downloadJobs   DownloadJob[]
  savedSearches  SavedSearch[]
}

model DebridConfig {
  autoImportLibrary Boolean @default(true)
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryProvider  String   @default("realdebrid") // "realdebrid" | "alldebrid" | "premiumize" | "torbox"
  fallbackOrder    String   @default("[]") // JSON array of provider ids; empty = use global order
  realDebridToken  String?
  allDebridApiKey  String?
  premiumizeApiKey String?
  torboxApiKey     String?
  updatedAt        DateTime @updatedAt
}

// A Torznab-compatible search endpoint, i.e. a Jackett indexer feed or a
// Prowlarr indexer's Torznab URL. Server-wide, managed by admins.
model IndexerConfig {
  id        String   @id @default(cuid())
  name      String
  baseUrl   String // full Torznab endpoint, e.g. http://jackett:9117/api/v2.0/indexers/all/results/torznab/api
  apiKey    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

// One search-result-to-stream pipeline: added by a user, tracked through
// the debrid provider until a playable link is resolved.
model DownloadJob {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  sourceUrl      String // magnet URI or hoster/direct link from the search result
  sizeBytes      Int       @default(0)
  seeders        Int       @default(0)
  indexerName    String?
  provider       String // provider id this job is running against
  providerRef    String? // provider-side torrent/transfer id, for status polling
  status         String    @default("queued") // "queued" | "downloading" | "finished" | "error"
  progress       Int       @default(0)
  streamUrl      String?
  filename       String?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([createdAt])
}

// A user's saved search — the query text plus the filters/sort they had
// set, so it can be one-click re-run later.
model SavedSearch {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  query      String
  minSeeders Int?
  maxSizeGb  Float?
  sort       String   @default("seeders") // "seeders" | "size" | "date"
  createdAt  DateTime @default(now())

  @@index([userId])
}

model LogEvent {
  id        String   @id @default(cuid())
  level     String   @default("info") // "info" | "warn" | "error"
  type      String // "signup" | "login" | "search" | "download" | "provider_error" | ...
  message   String
  userId    String?
  provider  String?
  meta      String? // JSON blob
  createdAt DateTime @default(now())

  @@index([type])
  @@index([level])
  @@index([createdAt])
}

// Key/value store for mutable server + provider settings managed via the admin API.
model Setting {
  key   String @id
  value String // JSON-encoded
}

model RevokedSession {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

// Durable metadata matching and refresh work for catalog or mounted-library targets.
// Library targets live outside SQLite; no foreign key can represent both kinds.
model MetadataRecord {
  ownerId       String?
  owner         User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  id            String   @id @default(cuid())
  targetType    String
  targetId      String
  name          String
  mediaType     String
  year          Int?
  status        String   @default("queued")
  requestedBy   String   @default("automatic")
  data          String   @default("{}")
  lockedFields  String   @default("[]")
  revision      Int      @default(0)
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil    DateTime?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([targetType, targetId])
  @@index([status, nextAttemptAt])
  @@index([ownerId])
}

// Private imports never persist signed media URLs or appear in the shared catalog.
model AccountMedia {
  id                    String @id @default(cuid())
  userId                String
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String
  providerRef           String
  credentialFingerprint String
  name                  String
  type                  String @default("movie")
  year                  Int?
  phase                 String
  progress              Int @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@unique([userId, provider, providerRef])
  @@index([userId, createdAt, id])
}

// One recoverable read-only scan per account/provider. Cursor and identity are private.
model AccountScan {
  id                    String @id @default(cuid())
  userId                String
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String
  status                String @default("queued")
  cursor                String?
  credentialFingerprint String
  automatic             Boolean @default(true)
  revision              Int @default(0)
  leaseUntil            DateTime?
  nextAttemptAt         DateTime @default(now())
  failures              Int @default(0)
  pages                 Int @default(0)
  scanned               Int @default(0)
  imported              Int @default(0)
  skipped               Int @default(0)
  error                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@unique([userId, provider])
  @@index([status, nextAttemptAt])
}

// One-use invitation secrets are hashed; only the creation response contains the link token.
model Invitation {
  id String @id @default(cuid())
  tokenHash String @unique
  email String
  createdById String
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  @@index([email, createdAt])
  @@index([expiresAt])
}

// An administrator deliberately publishes their imported account library to selected users.
model SharedLibrary {
  mediaRequests MediaRequest[]
  id String @id @default(cuid())
  name String
  sourceUserId String
  sourceUser User @relation(fields: [sourceUserId], references: [id], onDelete: Cascade)
  mediaType String @default("all")
  enabled Boolean @default(true)
  grants SharedLibraryGrant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sourceUserId, createdAt])
}

model SharedLibraryGrant {
  libraryId String
  library SharedLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([libraryId, userId])
  @@index([userId])
}

// A canonical title request is shared; followers remain private to their accounts.
model MediaRequest {
 id String @id @default(cuid())
 canonicalKey String @unique
 provider String
 externalId String
 mediaType String
 name String
 year Int?
 metadata String
 status String @default("requested")
 destination String?
 sourceUserId String?
 sourceUser User? @relation(fields: [sourceUserId], references: [id], onDelete: SetNull)
 sharedLibraryId String?
 sharedLibrary SharedLibrary? @relation(fields: [sharedLibraryId], references: [id], onDelete: SetNull)
 sourceUrl String?
 providerId String?
 providerRef String?
 sourceFingerprint String?
 progress Int?
 downloadState String?
 error String?
 revision Int @default(0)
 attempts Int @default(0)
 leaseUntil DateTime?
 nextPollAt DateTime @default(now())
 startedAt DateTime?
 downloadedAt DateTime?
 availableAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 followers RequestFollower[]
 events RequestEvent[]
 @@index([status, nextPollAt])
 @@index([sourceUserId])
 @@index([sharedLibraryId])
}
model RequestFollower {
 requestId String
 request MediaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 @@id([requestId, userId])
 @@index([userId, createdAt])
}
model RequestEvent {
 id String @id @default(cuid())
 requestId String
 request MediaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
 status String
 message String
 progress Int?
 createdAt DateTime @default(now())
 @@index([requestId, createdAt])
}
